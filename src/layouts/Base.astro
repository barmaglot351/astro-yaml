---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getProfile } from '../lib/profile';
import { formatBuildYear, getBuildInfo } from '../lib/build';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const profile = getProfile();
const build = getBuildInfo();
const pageTitle = title ? `${title} · ${profile.hero.name}` : `${profile.hero.name} · ${profile.hero.role}`;
const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="description" content={profile.hero.tagline} />
    <link rel="icon" href={`${assetBase}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">К содержимому</a>
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <span>© {formatBuildYear(build.time)}</span>
        <span>Автоматизировано и развёрнуто через CI/CD · sha {build.shortSha}</span>
      </footer>
    </div>
  </body>
</html>
