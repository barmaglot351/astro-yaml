---
import { renderEngineerYamlHtml } from '../lib/profile';
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const yamlHtml = renderEngineerYamlHtml(profile);
---

<section class="section" id="about">
  <h2 class="section-title">Обо мне</h2>
  <div class="about-grid">
    <div class="about-left">
      <p class="prompt-line">
        <span class="prompt">$</span> {profile.about.prompt}
      </p>
      {
        profile.about.title ? (
          <h3 class="about-heading">{profile.about.title}</h3>
        ) : null
      }
      <p class="about-text">{profile.about.text}</p>
      <ul class="contact-list">
        <li>
          <span class="contact-label">{profile.contacts.github.label}</span>
          <a href={profile.contacts.github.url} rel="noreferrer">{profile.contacts.github.handle}</a>
        </li>
        <li>
          <span class="contact-label">{profile.contacts.telegram.label}</span>
          <a href={profile.contacts.telegram.url} rel="noreferrer">{profile.contacts.telegram.handle}</a>
        </li>
        <li>
          <span class="contact-label">{profile.contacts.email.label}</span>
          <a href={profile.contacts.email.url}>{profile.contacts.email.handle}</a>
        </li>
      </ul>
    </div>
    <div class="code-panel yaml-panel">
      <div class="code-panel-head">
        <span class="dot red"></span>
        <span class="dot amber"></span>
        <span class="dot green"></span>
        <span class="code-panel-title">profile.yaml</span>
      </div>
      <pre class="code-panel-body yaml-body"><code class="yaml-code" set:html={yamlHtml}></code></pre>
    </div>
  </div>
</section>
